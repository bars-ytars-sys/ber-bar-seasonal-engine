# Скопировать этот файл в telegram/.env и заполнить.

# Токен от @BotFather (BotFather → /newbot → скопировать строку вида 12345:AA...)
TG_BOT_TOKEN=

# Кто имеет право писать боту. Свой id узнать так: запустить бота, написать ему
# что угодно — он ответит «Ваш chat id: ...». Несколько — через запятую.
TG_ALLOWED_IDS=

# Права агента на действия:
#   plan              — только планирует, ничего не меняет
#   acceptEdits       — правит файлы сам, но команды в терминале выполнять не может
#   bypassPermissions — делает всё без вопросов (нужно, если задачи требуют
#                       git, npm, скриптов проверки, MCP). Ставить осознанно:
#                       бот работает на вашей машине от вашего имени.
CLAUDE_PERMISSION_MODE=acceptEdits

# Необязательно: модель и лимит времени на одну задачу (мс).
# CLAUDE_MODEL=claude-opus-5
CLAUDE_TIMEOUT_MS=1800000

# Необязательно: полный путь к claude.exe, если он не в PATH.
# CLAUDE_BIN=C:\Users\ASON\.local\bin\claude.exe
